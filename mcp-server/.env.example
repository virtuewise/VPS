# Backend control-plane URL and one global or per-customer scoped bearer token.
VPS_MCP_API_URL=https://control-plane.example.com
VPS_MCP_READ_TOKEN=
VPS_MCP_TIMEOUT=10

# stdio is the default. For Streamable HTTP, bind loopback and reverse-proxy TLS.
VPS_MCP_TRANSPORT=stdio
VPS_MCP_HOST=127.0.0.1
VPS_MCP_PORT=8766
VPS_MCP_PATH=/mcp
VPS_MCP_ALLOWED_HOSTS=127.0.0.1:8766,localhost:8766
VPS_MCP_ALLOWED_ORIGINS=
