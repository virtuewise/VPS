# Copy this file to .env and replace both values before starting the control plane.
# Use a unique password with at least 16 characters.
VPS_ADMIN_PASSWORD=replace-this-with-a-long-unique-password

# Generate a random value with: py -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters. Never commit your real .env file.
VPS_SESSION_SECRET=replace-this-with-at-least-64-random-hex-characters

# Keep false for localhost development. Set true only when served over HTTPS.
VPS_SESSION_COOKIE_SECURE=false

# Optional: configure only when connecting a supported Hyper-V agent.
VPS_AGENT_URL=
VPS_AGENT_TOKEN=

# Optional dedicated read-only credential for the MCP integration.
# Generate independently from the session secret and node-agent token.
VPS_MCP_READ_TOKEN=replace-this-with-at-least-64-random-hex-characters
