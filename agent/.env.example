# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VPS_AGENT_TOKEN=replace-with-a-random-secret-at-least-32-characters
VPS_HYPERV_VM_ROOT=C:\VirtueWise\VMs
VPS_POWERSHELL=powershell.exe

# Optional: Windows ADK Deployment Tools oscdimg.exe for cloud-init seed media
# VPS_OSCDIMG=C:\Program Files (x86)\Windows Kits\10\Assessment and Deployment Kit\Deployment Tools\amd64\Oscdimg\oscdimg.exe

# Optional node identity: set all three to enable automatic control-plane heartbeats.
# Use HTTPS for remote control planes; HTTP is accepted only for loopback development.
# VPS_CONTROL_PLANE_URL=https://control.example.com
# VPS_NODE_ID=1
# VPS_NODE_TOKEN=the-one-time-node-credential-returned-during-enrollment
# VPS_HEARTBEAT_INTERVAL=60

# Optional third-party provider runtime. Keep the trust store administrator-controlled.
# Use only rootless Docker and an image pinned by its immutable sha256 digest.
# VPS_PROVIDER=plugin:org.example.provider.sample
# VPS_PROVIDER_REGISTRY=/var/lib/virtuewise/providers
# VPS_PROVIDER_TRUST_STORE=/etc/virtuewise/trusted-providers.json
# VPS_PROVIDER_SANDBOX=docker
# VPS_PROVIDER_SANDBOX_IMAGE=python:3.11-slim@sha256:REPLACE_WITH_VERIFIED_IMAGE_DIGEST
